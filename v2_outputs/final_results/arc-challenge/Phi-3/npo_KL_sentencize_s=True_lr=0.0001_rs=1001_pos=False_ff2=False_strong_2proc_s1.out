{"id": "Mercury_180373", "question": "How are sedimentary rocks made?", "step_idx": 2, "options": ["A): Magma or lava is cooled.", "B): Materials are pressed together.", "C): Chemical reactions change minerals.", "D): Earthquakes cause small pieces to fall."], "correct": "B", "initial_cot": "1. Sedimentary rocks are formed from the accumulation of sediments.\n2. These sediments are often deposited by water, wind, or ice.\n3. Over time, the sediments are compacted and cemented together.\n4. This process is called lithification.", "initial_cot_probs": [1.415968453599703e-09, 1.0125514563696925e-05, 3.39673200677737e-09, 8.588283417765297e-10], "initial_probs": [1.1231109198206468e-07, 0.0001231640635523945, 1.4421030414268898e-07, 6.812012287582547e-08], "prediction": 1, "cot_prediction": 1, "adapter_id": "Mercury_180373_step_2", "global_job_index": 629, "cot_step": "2.", "segmented_cot": ["1.", "Sedimentary rocks are formed from the accumulation of sediments.", "2.", "These sediments are often deposited by water, wind, or ice.", "3.", "Over time, the sediments are compacted and cemented together.", "4.", "This process is called lithification."], "adapter_record": {"base_model_id": "microsoft/Phi-3-mini-4k-instruct", "adapter_id": "Mercury_180373_step_2", "adapter_path": "../../../../adapters/arc-challenge/Phi-3/npo_KL_sentencize_s=True_lr=0.0001_rs=1001_pos=False_ff2=False_strong_2proc_s1/Mercury_180373_step_2.pt", "metadata": {"base_model_id": "microsoft/Phi-3-mini-4k-instruct", "dataset": "arc-challenge", "strategy": "sentencize", "stepwise": true, "method": "npo_KL", "instance_id": "Mercury_180373", "step_idx": 2, "target_index": 79, "global_job_index": 629, "question": "How are sedimentary rocks made?"}}, "adapter_record_path": "v2_outputs/adapter_records/arc-challenge/Phi-3/npo_KL_sentencize_s=True_lr=0.0001_rs=1001_pos=False_ff2=False_strong_2proc_s1/Mercury_180373_step_2.json", "adapter_training_history": [{"epoch": 1, "mean_loss": 13.862943649291992, "evaluat